{
  "name": "kafka-console-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.3",
    "@ant-design/icons-vue": "^7.0.1",
    "axios": "^1.7.7",
    "core-js": "^3.38.1",
    "dayjs": "^1.11.13",
    "vue": "^3.5.6",
    "vue-router": "^4.4.5",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vue-tsc": "^2.1.6",
    "@types/node": "^22.5.5",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.28.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.3",
    "lint-staged": "^15.2.10"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  }
}
